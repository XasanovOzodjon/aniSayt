SECRET_KEY=change-me-in-dotenv
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=anisayt
DB_USER=anisayt
DB_PASSWORD=anisayt
DB_HOST=localhost
DB_PORT=5432
BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=animeediabot
GOOGLE_CLIENT_ID=change-me
GOOGLE_PROJECT_ID=change-me
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_URI=https://oauth2.googleapis.com/oauth2/v2/userinfo
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/googleCallback
SITE_URL=http://localhost:8000
# DEBUG=True allows ngrok hosts automatically (test from another phone/PC).
# Production:
#   DEBUG=False
#   SECRET_KEY at least 50 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   SITE_URL=https://animee.uz,https://www.animee.uz
#   ALLOWED_HOSTS=animee.uz,www.animee.uz
#   GOOGLE_REDIRECT_URL=https://animee.uz/api/auth/googleCallback
#   REDIS_URL=redis://127.0.0.1:6379/0
#   SECURE_SSL_REDIRECT=True behind Nginx+HTTPS
REDIS_URL=redis://127.0.0.1:6379/0
# Camera/mic across networks: docker compose up -d coturn, then public IP:
# TURN_URL=turn:YOUR_PUBLIC_IP:3478
TURN_URL=turn:127.0.0.1:3478
TURN_URLS=turn:127.0.0.1:3478,turn:127.0.0.1:3478?transport=tcp
TURN_USERNAME=animee
TURN_CREDENTIAL=change-me
TURN_REALM=animee.uz
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# Google Account → App passwords. Never commit. Rotate if it ever appeared in git/chat.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# S3 media (empty = local disk). Fill via: bash scripts/setup-aws-s3.sh
# Aliases also work: AWS_S3_ACCESS_KEY_ID / AWS_S3_SECRET_ACCESS_KEY
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-north-1
